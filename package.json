{
  "name": "@expert-vision-software/programmatic-seo",
  "version": "0.0.0",
  "description": "Framework-agnostic programmatic SEO engine: declarative page specs, chainable builders, managed JSON-LD @graph, and head rendering.",
  "type": "module",
  "license": "MIT",
  "author": "Expert Vision Software",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Expert-Vision-Software/programmatic-seo.git"
  },
  "bugs": {
    "url": "https://github.com/Expert-Vision-Software/programmatic-seo/issues"
  },
  "homepage": "https://github.com/Expert-Vision-Software/programmatic-seo#readme",
  "keywords": [
    "seo",
    "meta-tags",
    "json-ld",
    "schema.org",
    "structured-data",
    "open-graph",
    "twitter-card",
    "typescript",
    "framework-agnostic"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
