    "capture-baseline": "bun scripts/capture-baseline.ts"
  },
  "dependencies": {
    "schema-dts": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^27.0.0",
    "playwright": "^1.65.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
