            "mainEntity": {
              "@type": "Question",
              "name": "Why are bills duplicated sometimes?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Bills often appear in duplicate because of a deliberate legislative tactic called companion bills — identical or nearly identical legislation introduced simultaneously in both the House and the Senate. This strategy allows both chambers to work on the same policy in parallel, dramatically shortening the time it takes to reach a floor vote.",
                "url": "https://billgrokker.com/faq#why-are-bills-duplicated"
              }
            }
